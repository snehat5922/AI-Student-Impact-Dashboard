from PIL import Image, ImageDraw, ImageFont

# Banner dimensions
width = 1600
height = 400

# Create background
img = Image.new("RGB", (width, height), "#0F172A")
draw = ImageDraw.Draw(img)

# Gradient-like rectangles
draw.rectangle((0, 0, width, height), fill="#0F172A")
draw.ellipse((1200, -100, 1700, 400), fill="#4F46E5")
draw.ellipse((-150, 150, 350, 650), fill="#06B6D4")

# Load fonts
try:
    title_font = ImageFont.truetype("arial.ttf", 70)
    subtitle_font = ImageFont.truetype("arial.ttf", 35)
except:
    title_font = ImageFont.load_default()
    subtitle_font = ImageFont.load_default()

# Main Title
draw.text(
    (80, 100),
    "AI Student Impact Dashboard",
    fill="white",
    font=title_font
)

# Subtitle
draw.text(
    (85, 210),
    "Analyzing the Influence of Generative AI on Student Performance",
    fill="#CBD5E1",
    font=subtitle_font
)

# Decorative icon
draw.text(
    (1350, 120),
    "🎓",
    fill="white",
    font=title_font
)

# Save banner
img.save("banner.png")

print("banner.png created successfully!")
